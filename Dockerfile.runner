# Runner image: agentq runner + claude CLI.
# Credentials: mount ~/.claude (for claude login) or set ANTHROPIC_API_KEY.
FROM golang:1.26-bookworm AS builder
ENV CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /bin/agentq ./cmd/agentq

FROM node:22-slim
RUN npm install -g @anthropic-ai/claude-code
COPY --from=builder /bin/agentq /usr/local/bin/agentq
ENTRYPOINT ["/usr/local/bin/agentq"]
