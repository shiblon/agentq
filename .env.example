# Copy to .env and fill in values before running docker compose.
# Run deploy/zitadel-bootstrap.sh after first `docker compose up` to
# generate SUPERVISOR_CLIENT_ID and SUPERVISOR_CLIENT_SECRET.

# --- Supervisor token exchange ---
# Output by deploy/zitadel-bootstrap.sh
SUPERVISOR_CLIENT_ID=
SUPERVISOR_CLIENT_SECRET=

# --- Ollama model storage ---
# Host path for Ollama model cache. Defaults to a temp dir if unset.
OLLAMA_MODELS=/tmp/agentq-ollama-models
