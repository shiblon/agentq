# Copy to .env and fill in values before running docker compose.
# Run deploy/zitadel-bootstrap.sh after first `docker compose up` to
# generate SUPERVISOR_CLIENT_ID and SUPERVISOR_CLIENT_SECRET.

# --- Supervisor token exchange ---
# Output by deploy/zitadel-bootstrap.sh
SUPERVISOR_CLIENT_ID=
SUPERVISOR_CLIENT_SECRET=

# --- entroq queue authorization tokens ---
# Bearer tokens for each agent to authenticate with the entroq queue server.
# Obtain from your IDP (e.g. Zitadel machine user access tokens).
# Sub claims from these tokens must match entries in config/entroq-policy/data.json.
API_EQ_TOKEN=
SUPERVISOR_EQ_TOKEN=
CODER_EQ_TOKEN=
REVIEWER_EQ_TOKEN=
RESEARCHER_EQ_TOKEN=

# --- Session provenance + approval token keys ---
# Generate once with: agentq keygen (or: openssl rand -base64 32)
# Both the API server and supervisor must share the same PROVENANCE_KEY.
# The supervisor and all exec workers must share the same APPROVAL_KEY.
PROVENANCE_KEY=
APPROVAL_KEY=

# --- Ollama model storage ---
# Host path for Ollama model cache. Defaults to a temp dir if unset.
OLLAMA_MODELS=/tmp/agentq-ollama-models
